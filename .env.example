# Copy to .env and change the secrets. Everything has a working dev default,
# so `docker compose up` also works without a .env file.

# --- infrastructure (used by compose.yaml) ---
POSTGRES_PASSWORD=clipper
POSTGRES_PORT=5433
S3_ACCESS_KEY=clipper
S3_SECRET_KEY=clipper-dev-secret

# --- Twitch app (dev.twitch.tv/console -> Applications). Only the controller needs it;
#     chat logging works without it. Used by compose and by native runs.
CLIPPER_TWITCH_CLIENT_ID=
CLIPPER_TWITCH_CLIENT_SECRET=

# --- recorder (optional) ---
# streamlink stream names tried in order for `full` mode; best = source (~8 Mbps at 1080p60)
CLIPPER_RECORDER_QUALITIES=best
# CLIPPER_RECORDER_CHUNK_SECONDS=60
# CLIPPER_RECORDER_SPOOL_DIR=data/spool   # native runs; the container uses the spool volume

# --- apps running natively on Windows during development (`uv run ...`) ---
CLIPPER_DATABASE_URL=postgresql+psycopg://clipper:clipper@127.0.0.1:5433/clipper
CLIPPER_S3_ENDPOINT=http://127.0.0.1:8333
CLIPPER_S3_ACCESS_KEY=clipper
CLIPPER_S3_SECRET_KEY=clipper-dev-secret
CLIPPER_S3_BUCKET=clipper
CLIPPER_LOG_LEVEL=INFO
# auto = readable text in a terminal, JSON lines otherwise (containers). Or: json | console
CLIPPER_LOG_FORMAT=auto
# per-logger overrides, e.g. sqlalchemy.engine=INFO,botocore=DEBUG
CLIPPER_LOG_LEVELS=
