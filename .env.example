# Copy to .env and change the secrets. Everything has a working dev default,
# so `docker compose up` also works without a .env file.

# --- infrastructure (used by compose.yaml) ---
POSTGRES_PASSWORD=clipper
POSTGRES_PORT=5433
S3_ACCESS_KEY=clipper
S3_SECRET_KEY=clipper-dev-secret

# --- apps running natively on Windows during development (`uv run ...`) ---
CLIPPER_DATABASE_URL=postgresql+psycopg://clipper:clipper@127.0.0.1:5433/clipper
CLIPPER_S3_ENDPOINT=http://127.0.0.1:8333
CLIPPER_S3_ACCESS_KEY=clipper
CLIPPER_S3_SECRET_KEY=clipper-dev-secret
CLIPPER_S3_BUCKET=clipper
CLIPPER_LOG_LEVEL=INFO
